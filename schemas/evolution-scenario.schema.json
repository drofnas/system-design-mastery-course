{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/evolution-scenario.schema.json",
  "title": "Module 14 architecture evolution failure scenario",
  "type": "object",
  "required": ["schema_version","scenario_id","pair_id","variant","seed","workload","contracts","migration","writes","traffic","costs","dependency","ownership","controls","expected"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "scenario_id": {"type":"string","pattern":"^f0[1-9]-[a-z0-9-]+-(broken|repaired)$"},
    "pair_id": {"type":"string","pattern":"^F0[1-9]$"},
    "variant": {"enum":["broken","repaired"]},
    "seed": {"type":"integer","minimum":1},
    "workload": {"type":"object","required":["nightly_reads","nightly_publications","burst_multiplier","good_reads"],"properties":{"nightly_reads":{"type":"integer","minimum":0},"nightly_publications":{"type":"integer","minimum":0},"burst_multiplier":{"type":"number","minimum":1},"good_reads":{"type":"integer","minimum":1}},"additionalProperties":false},
    "contracts": {"type":"object","required":["producer_version","consumer_version","required_fields","emitted_fields","unknown_fields_tolerated"],"properties":{"producer_version":{"type":"integer","minimum":1},"consumer_version":{"type":"integer","minimum":1},"required_fields":{"type":"array","items":{"type":"string"},"uniqueItems":true},"emitted_fields":{"type":"array","items":{"type":"string"},"uniqueItems":true},"unknown_fields_tolerated":{"type":"boolean"}},"additionalProperties":false},
    "migration": {"type":"object","required":["phase","total_records","processed_records","checkpoint","crash_after_write","source_version","projected_version","old_reader_present","rollback_state_compatible"],"properties":{"phase":{"enum":["baseline","expand","backfill","shadow","cutover","contract","decommission"]},"total_records":{"type":"integer","minimum":0},"processed_records":{"type":"integer","minimum":0},"checkpoint":{"type":"integer","minimum":0},"crash_after_write":{"type":"boolean"},"source_version":{"type":"integer","minimum":0},"projected_version":{"type":"integer","minimum":0},"old_reader_present":{"type":"boolean"},"rollback_state_compatible":{"type":"boolean"}},"additionalProperties":false},
    "writes": {"type":"object","required":["source_of_truth","registry_value","catalog_value","independent_dual_write"],"properties":{"source_of_truth":{"type":"string"},"registry_value":{"type":"string"},"catalog_value":{"type":"string"},"independent_dual_write":{"type":"boolean"}},"additionalProperties":false},
    "traffic": {"type":"object","required":["shadow_percent","sample_count","mismatches","hard_mismatch","promotion_threshold","cutover_percent"],"properties":{"shadow_percent":{"type":"number","minimum":0,"maximum":100},"sample_count":{"type":"integer","minimum":0},"mismatches":{"type":"integer","minimum":0},"hard_mismatch":{"type":"boolean"},"promotion_threshold":{"type":"number","minimum":0,"maximum":1},"cutover_percent":{"type":"number","minimum":0,"maximum":100}},"additionalProperties":false},
    "costs": {"type":"object","required":["direct","shared","labor","transition","risk","good_outcomes","budget_per_1000"],"properties":{"direct":{"type":"number","minimum":0},"shared":{"type":"number","minimum":0},"labor":{"type":"number","minimum":0},"transition":{"type":"number","minimum":0},"risk":{"type":"number","minimum":0},"good_outcomes":{"type":"integer","minimum":1},"budget_per_1000":{"type":"number","minimum":0}},"additionalProperties":false},
    "dependency": {"type":"object","required":["name","quota","required_peak","price_multiplier","portable_contract","export_ready","fallback_ready"],"properties":{"name":{"type":"string"},"quota":{"type":"integer","minimum":0},"required_peak":{"type":"integer","minimum":0},"price_multiplier":{"type":"number","minimum":0},"portable_contract":{"type":"boolean"},"export_ready":{"type":"boolean"},"fallback_ready":{"type":"boolean"}},"additionalProperties":false},
    "ownership": {"type":"object","required":["primary","secondary_count","runbook_verified","access_verified","handoff_passed"],"properties":{"primary":{"type":"string"},"secondary_count":{"type":"integer","minimum":0},"runbook_verified":{"type":"boolean"},"access_verified":{"type":"boolean"},"handoff_passed":{"type":"boolean"}},"additionalProperties":false},
    "controls": {"type":"object","required":["backward_compatible_contract","expand_contract_sequencing","resumable_backfill","single_write_authority","shadow_comparison_gate","tested_cutover_rollback","unit_cost_budget","dependency_exit_plan","ownership_continuity"],"properties":{"backward_compatible_contract":{"type":"boolean"},"expand_contract_sequencing":{"type":"boolean"},"resumable_backfill":{"type":"boolean"},"single_write_authority":{"type":"boolean"},"shadow_comparison_gate":{"type":"boolean"},"tested_cutover_rollback":{"type":"boolean"},"unit_cost_budget":{"type":"boolean"},"dependency_exit_plan":{"type":"boolean"},"ownership_continuity":{"type":"boolean"}},"additionalProperties":false},
    "expected": {"type":"object","required":["target_invariant","repaired_invariants"],"properties":{"target_invariant":{"type":"string","pattern":"^I(0[1-9]|1[0-2])$"},"repaired_invariants":{"type":"array","minItems":12,"maxItems":12,"items":{"type":"string","pattern":"^I(0[1-9]|1[0-2])$"},"uniqueItems":true}},"additionalProperties":false}
  },
  "additionalProperties": false
}
