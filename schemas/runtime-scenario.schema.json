{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/system-design-course/runtime-scenario.schema.json",
  "title":"Module 15 runtime failure scenario",
  "type":"object",
  "required":["schema_version","scenario_id","pair_id","variant","runtime","seed","workload","limits","fault","controls","expected"],
  "properties":{
    "schema_version":{"const":"1.0"},"scenario_id":{"type":"string","pattern":"^f0[1-9]-[a-z0-9-]+-(broken|repaired)$"},"pair_id":{"type":"string","pattern":"^F0[1-9]$"},"variant":{"enum":["broken","repaired"]},"runtime":{"enum":["typescript","go","rust","java"]},"seed":{"type":"integer","minimum":1},
    "workload":{"type":"object","required":["requests","children_per_request","payload_bytes","child_delay_ms"],"properties":{"requests":{"type":"integer","minimum":1,"maximum":10000},"children_per_request":{"type":"integer","minimum":1,"maximum":16},"payload_bytes":{"type":"integer","minimum":0,"maximum":2097152},"child_delay_ms":{"type":"integer","minimum":0,"maximum":10000}},"additionalProperties":false},
    "limits":{"type":"object","required":["deadline_ms","max_requests","max_children","memory_bytes","cleanup_grace_ms"],"properties":{"deadline_ms":{"type":"integer","minimum":50,"maximum":5000},"max_requests":{"type":"integer","minimum":1,"maximum":256},"max_children":{"type":"integer","minimum":1,"maximum":1024},"memory_bytes":{"type":"integer","minimum":1048576},"cleanup_grace_ms":{"type":"integer","minimum":1,"maximum":5000}},"additionalProperties":false},
    "fault":{"enum":["event_loop_block","worker_exhaustion","task_leak","allocation_pressure","gc_pause","data_race","missing_cancellation","resource_leak","invalid_json"]},
    "controls":{"type":"object","required":["partition_cpu_work","bounded_admission","joined_task_scope","bounded_buffers","gc_observation","synchronized_state","propagate_cancellation","lexical_resource_scope","runtime_validation"],"properties":{"partition_cpu_work":{"type":"boolean"},"bounded_admission":{"type":"boolean"},"joined_task_scope":{"type":"boolean"},"bounded_buffers":{"type":"boolean"},"gc_observation":{"type":"boolean"},"synchronized_state":{"type":"boolean"},"propagate_cancellation":{"type":"boolean"},"lexical_resource_scope":{"type":"boolean"},"runtime_validation":{"type":"boolean"}},"additionalProperties":false},
    "expected":{"type":"object","required":["target_invariant"],"properties":{"target_invariant":{"type":"string","pattern":"^I(0[1-9]|10)$"}},"additionalProperties":false}
  },
  "additionalProperties":false
}
