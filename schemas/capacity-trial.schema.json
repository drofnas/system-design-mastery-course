{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/capacity-trial.schema.json",
  "title": "Capacity lab trial summary",
  "type": "object",
  "required": [
    "scenario_id",
    "arrival_mode",
    "duration_seconds",
    "offered_rate_per_second",
    "logical_requests",
    "attempts",
    "accepted_attempts",
    "rejected_attempts",
    "unique_successes",
    "useful_throughput_per_second",
    "latency_ms",
    "queue_wait_ms",
    "generator_lag_ms",
    "queue_depth",
    "max_service_concurrency",
    "max_downstream_concurrency",
    "retry_budget",
    "estimated_cost_per_useful_request",
    "prediction_comparison",
    "failure_reason"
  ],
  "properties": {
    "scenario_id": {"type": "string"},
    "arrival_mode": {"enum": ["open", "closed"]},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "offered_rate_per_second": {"type": "number", "minimum": 0},
    "logical_requests": {"type": "integer", "minimum": 0},
    "attempts": {"type": "integer", "minimum": 0},
    "accepted_attempts": {"type": "integer", "minimum": 0},
    "rejected_attempts": {"type": "integer", "minimum": 0},
    "unique_successes": {"type": "integer", "minimum": 0},
    "useful_throughput_per_second": {"type": "number", "minimum": 0},
    "latency_ms": {"$ref": "#/$defs/percentiles"},
    "queue_wait_ms": {"$ref": "#/$defs/percentiles"},
    "generator_lag_ms": {"$ref": "#/$defs/percentiles"},
    "queue_depth": {
      "type": "object",
      "required": ["first", "last", "peak", "slope_per_second"],
      "properties": {
        "first": {"type": "integer", "minimum": 0},
        "last": {"type": "integer", "minimum": 0},
        "peak": {"type": "integer", "minimum": 0},
        "slope_per_second": {"type": "number"}
      },
      "additionalProperties": false
    },
    "max_service_concurrency": {"type": "integer", "minimum": 0},
    "max_downstream_concurrency": {"type": "integer", "minimum": 0},
    "retry_budget": {
      "type": "object",
      "required": ["limit", "used", "exhausted"],
      "properties": {
        "limit": {"type": "integer", "minimum": 0},
        "used": {"type": "integer", "minimum": 0},
        "exhausted": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "estimated_cost_per_useful_request": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "prediction_comparison": {
      "type": "object",
      "required": [
        "predicted_bottleneck",
        "predicted_capacity_per_second",
        "offered_fraction_of_predicted_capacity",
        "useful_fraction_of_predicted_capacity",
        "predicted_concurrency_at_observed_rate",
        "observed_peak_service_concurrency"
      ],
      "properties": {
        "predicted_bottleneck": {"enum": ["workers", "downstream"]},
        "predicted_capacity_per_second": {"type": "number", "minimum": 0},
        "offered_fraction_of_predicted_capacity": {"type": "number", "minimum": 0},
        "useful_fraction_of_predicted_capacity": {"type": "number", "minimum": 0},
        "predicted_concurrency_at_observed_rate": {"type": "number", "minimum": 0},
        "observed_peak_service_concurrency": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "failure_reason": {"type": ["string", "null"]}
  },
  "$defs": {
    "percentiles": {
      "type": "object",
      "required": ["p50", "p95", "p99", "max"],
      "properties": {
        "p50": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "p99": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
