{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/solo-review.schema.json",
  "title": "Frozen solo-review packet",
  "type": "object",
  "required": ["schema_version", "module", "artifact", "seed", "question_ids", "questions", "reviewer_roles", "response_instructions", "disclosure_requirements"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "module": {"type": "string", "pattern": "^M(0[1-9]|1[0-8])$"},
    "artifact": {
      "type": "object",
      "required": ["repository_relative_path", "sha256", "commit"],
      "properties": {
        "repository_relative_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      },
      "additionalProperties": false
    },
    "seed": {"type": "integer", "minimum": 0},
    "question_ids": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "questions": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "required": ["id", "prompt"],
        "properties": {"id": {"type": "string"}, "prompt": {"type": "string", "minLength": 20}},
        "additionalProperties": false
      }
    },
    "reviewer_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "response_instructions": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "disclosure_requirements": {"type": "array", "minItems": 2, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
