{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/portfolio-items.schema.json",
  "title": "PESD-104 featured portfolio registry",
  "type": "object",
  "required": ["course_id", "version", "items"],
  "properties": {
    "$schema": {"type": "string"},
    "course_id": {"const": "PESD-104"},
    "version": {"const": "2.0"},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "evidence_lineage_id", "components", "credit_component"],
        "properties": {
          "id": {"type": "string", "pattern": "^PI-[A-Z0-9-]+$"},
          "title": {"type": "string", "minLength": 3},
          "category": {"type": "string", "minLength": 3},
          "evidence_lineage_id": {"type": "string", "pattern": "^LIN-[A-Z0-9-]+$"},
          "components": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["owner", "artifact", "role"],
              "properties": {
                "owner": {"type": "string", "pattern": "^(M|G|F)(0[1-9]|1[0-8])$"},
                "artifact": {"type": "string", "minLength": 2},
                "role": {"enum": ["baseline", "prediction", "implementation", "raw_evidence", "analysis", "decision", "revision", "final"]}
              },
              "additionalProperties": false
            }
          },
          "credit_component": {"type": "string", "minLength": 4}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
