{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/course-resources.schema.json",
  "title": "Global course setup resources",
  "type": "object",
  "required": ["schema_version", "resources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "title", "author_or_publisher", "type", "url", "required",
          "access", "purpose", "reading_boundary", "last_verified",
          "text_alternative", "verified_title", "verified_publisher",
          "verification_method", "final_url", "verification_status"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^SETUP-[0-9]{2}$"},
          "title": {"type": "string", "minLength": 3},
          "author_or_publisher": {"type": "string", "minLength": 2},
          "type": {"type": "string", "minLength": 3},
          "url": {"type": "string", "pattern": "^https://"},
          "required": {"type": "boolean"},
          "access": {"const": "free"},
          "purpose": {"type": "string", "minLength": 20},
          "reading_boundary": {"type": "string", "minLength": 20},
          "last_verified": {"type": "string", "format": "date"},
          "text_alternative": {"const": "HOME_LAB_GUIDE.md"},
          "verified_title": {"type": "string", "minLength": 3},
          "verified_publisher": {"type": "string", "minLength": 2},
          "verification_method": {"enum": ["HTTP GET plus primary-source metadata comparison", "manual primary-source verification"]},
          "final_url": {"type": "string", "pattern": "^https://"},
          "verification_status": {"const": "verified"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
