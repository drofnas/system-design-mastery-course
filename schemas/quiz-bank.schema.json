{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/solo-course/quiz-bank.schema.json",
  "title": "Solo course quiz bank",
  "type": "object",
  "required": [
    "module_id",
    "title",
    "questions"
  ],
  "properties": {
    "module_id": {
      "type": "string",
      "pattern": "^M[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "questions": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "module_id",
          "lesson_ids",
          "type",
          "difficulty",
          "prompt",
          "correct_answer",
          "explanation",
          "grading_notes",
          "tags"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^M[0-9]{2}-Q[0-9]{3}$"
          },
          "module_id": {
            "type": "string",
            "pattern": "^M[0-9]{2}$"
          },
          "lesson_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^L[0-9]{2}$"
            }
          },
          "type": {
            "enum": [
              "multiple_choice",
              "short_answer",
              "calculation",
              "scenario_diagnosis",
              "design_judgment"
            ]
          },
          "difficulty": {
            "enum": [
              "recall",
              "application",
              "synthesis"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 20
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "correct_answer": {
            "type": "string",
            "minLength": 3
          },
          "explanation": {
            "type": "string",
            "minLength": 10
          },
          "grading_notes": {
            "type": "string",
            "minLength": 10
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
