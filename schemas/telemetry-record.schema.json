{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/telemetry-record.schema.json",
  "title": "Module 4 provider-neutral telemetry record",
  "oneOf": [
    {"$ref": "#/$defs/span"},
    {"$ref": "#/$defs/metric"},
    {"$ref": "#/$defs/log"}
  ],
  "$defs": {
    "attributeValue": {
      "oneOf": [
        {"type": "string"},
        {"type": "number"},
        {"type": "boolean"}
      ]
    },
    "traceId": {"type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$"},
    "spanId": {"type": "string", "pattern": "^(?!0{16}$)[0-9a-f]{16}$"},
    "common": {
      "type": "object",
      "required": ["schema_version", "signal", "timestamp_unix_ns"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "timestamp_unix_ns": {"type": "integer", "minimum": 1}
      }
    },
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "signal", "timestamp_unix_ns", "trace_id", "span_id", "parent_span_id", "name", "duration_ms", "status", "attributes"],
      "properties": {
        "schema_version": {"const": "1.0"}, "signal": {"const": "span"},
        "timestamp_unix_ns": {"type": "integer", "minimum": 1},
        "trace_id": {"$ref": "#/$defs/traceId"},
        "span_id": {"$ref": "#/$defs/spanId"},
        "parent_span_id": {"oneOf": [{"$ref": "#/$defs/spanId"}, {"type": "null"}]},
        "name": {"type": "string", "minLength": 1}, "duration_ms": {"type": "number", "minimum": 0},
        "status": {"enum": ["ok", "error"]},
        "attributes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/attributeValue"}}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "signal", "timestamp_unix_ns", "name", "value", "unit", "attributes", "exemplar"],
      "properties": {
        "schema_version": {"const": "1.0"}, "signal": {"const": "metric"},
        "timestamp_unix_ns": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1}, "value": {"type": "number"}, "unit": {"type": "string", "minLength": 1},
        "attributes": {"type": "object", "additionalProperties": {"type": "string"}},
        "exemplar": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["trace_id", "span_id"],
              "properties": {
                "trace_id": {"$ref": "#/$defs/traceId"},
                "span_id": {"$ref": "#/$defs/spanId"}
              }
            }
          ]
        }
      }
    },
    "log": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "signal", "timestamp_unix_ns", "event_name", "severity", "trace_id", "span_id", "attributes"],
      "properties": {
        "schema_version": {"const": "1.0"}, "signal": {"const": "log"},
        "timestamp_unix_ns": {"type": "integer", "minimum": 1},
        "event_name": {"type": "string", "minLength": 1}, "severity": {"enum": ["INFO", "WARN", "ERROR"]},
        "trace_id": {"oneOf": [{"$ref": "#/$defs/traceId"}, {"type": "null"}]},
        "span_id": {"oneOf": [{"$ref": "#/$defs/spanId"}, {"type": "null"}]},
        "attributes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/attributeValue"}}
      }
    }
  }
}
