{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/blind-collection.schema.json",
  "title": "Module 4 learner-visible blind collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collection_id", "created_at", "items", "reveal_required"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "collection_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "created_at": {"type": "string", "minLength": 20},
    "reveal_required": {"const": true},
    "reveal_mode": {"enum": ["partner", "solo"]},
    "envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "items": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["opaque_id", "bundle", "summary_sha256"],
        "properties": {
          "opaque_id": {"type": "string", "pattern": "^O[0-9]{2}$"},
          "bundle": {"type": "string", "pattern": "^O[0-9]{2}$"},
          "summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
