{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/evidence-envelope.schema.json",
  "title": "PESD-104 local experiment evidence envelope",
  "type": "object",
  "required": [
    "schema_version", "module_id", "source_commit", "evidence_mode",
    "independent_evidence_eligible", "inputs", "configurations",
    "runtime_boundary", "resource_limits", "clock", "execution_policy",
    "raw_outcomes", "limitations", "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "module_id": {"type": "string", "pattern": "^M(0[1-9]|1[0-8])$"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "evidence_mode": {
      "enum": [
        "derived", "executed_deterministic", "measured_loopback",
        "measured_container", "modeled_capacity", "fixture_replay",
        "measured_accelerator"
      ]
    },
    "independent_evidence_eligible": {"type": "boolean"},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_file"}},
    "configurations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_file"}},
    "runtime_boundary": {
      "type": "object",
      "required": ["kind", "os", "architecture", "runtime"],
      "properties": {
        "kind": {"enum": ["local_native", "local_container", "remote_container", "accelerator", "modeled"]},
        "os": {"type": "string", "minLength": 2},
        "architecture": {"type": "string", "minLength": 2},
        "runtime": {"type": "string", "minLength": 2}
      },
      "additionalProperties": false
    },
    "resource_limits": {
      "type": "object",
      "required": ["cpu", "memory", "pids"],
      "properties": {
        "cpu": {"type": "string", "minLength": 1},
        "memory": {"type": "string", "minLength": 1},
        "pids": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "required": ["source", "timing_boundary"],
      "properties": {
        "source": {"type": "string", "minLength": 2},
        "timing_boundary": {"type": "string", "minLength": 4}
      },
      "additionalProperties": false
    },
    "execution_policy": {
      "type": "object",
      "required": ["warmups", "repetitions", "exclusion_policy"],
      "properties": {
        "warmups": {"type": "integer", "minimum": 0},
        "repetitions": {"type": "integer", "minimum": 1},
        "exclusion_policy": {"type": "string", "minLength": 3}
      },
      "additionalProperties": false
    },
    "raw_outcomes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "source_file": {
      "type": "object",
      "required": ["path", "sha256", "source_blob_sha256", "matches_source_commit"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_blob_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "matches_source_commit": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_mode": {"enum": ["derived", "modeled_capacity", "fixture_replay"]}
        },
        "required": ["evidence_mode"]
      },
      "then": {"properties": {"independent_evidence_eligible": {"const": false}}},
      "else": {"properties": {"independent_evidence_eligible": {"const": true}}}
    }
  ],
  "additionalProperties": false
}
