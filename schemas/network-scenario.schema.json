{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/system-design-course/network-scenario.schema.json",
  "title":"Module 5 network scenario",
  "type":"object",
  "oneOf":[
    {"properties":{"mode":{"const":"trace"},"protocol":{"const":"h1"},"fault":{"properties":{"type":{"enum":["baseline","reset","dns_failure","slow_reader"]}}},"limits":{"properties":{"max_connections":{"type":"integer","minimum":3,"maximum":128}}}}},
    {"properties":{"mode":{"const":"simulate"},"protocol":{"enum":["h2_tcp","h3_quic"]},"fault":{"properties":{"type":{"enum":["delay","jitter","loss","reordering","bandwidth","pool_exhaustion"]}}}}}
  ],
  "required":["schema_version","id","seed","mode","protocol","client_population","path","streams","fault","limits","expected_work"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "id":{"type":"string","minLength":1},
    "seed":{"type":"integer"},
    "mode":{"enum":["trace","simulate"]},
    "protocol":{"enum":["h1","h2_tcp","h3_quic"]},
    "client_population":{"type":"string","minLength":1},
    "path":{"type":"object","required":["rtt_ms","bandwidth_kbps"],"properties":{"rtt_ms":{"type":"number","exclusiveMinimum":0},"bandwidth_kbps":{"type":"number","exclusiveMinimum":0}},"additionalProperties":false},
    "streams":{"type":"array","minItems":1,"items":{"type":"object","required":["id","bytes"],"properties":{"id":{"type":"string","minLength":1},"bytes":{"type":"integer","minimum":1}},"additionalProperties":false}},
    "fault":{"type":"object","required":["type"],"properties":{"type":{"enum":["baseline","delay","jitter","loss","reordering","bandwidth","reset","dns_failure","slow_reader","pool_exhaustion"]},"delay_ms":{"type":"number","minimum":0},"jitter_ms":{"type":"number","minimum":0},"recovery_ms":{"type":"number","minimum":0},"reorder_ms":{"type":"number","minimum":0},"reader_delay_ms":{"type":"number","minimum":0},"bandwidth_kbps":{"type":"number","exclusiveMinimum":0},"stream_id":{"type":"string"},"packet_index":{"type":"integer","minimum":0},"connections":{"type":"integer","minimum":1}},"additionalProperties":false},
    "limits":{"type":"object","required":["timeout_ms","max_connections","max_bytes"],"properties":{"timeout_ms":{"type":"integer","minimum":1,"maximum":30000},"max_connections":{"type":"integer","minimum":1,"maximum":128},"max_bytes":{"type":"integer","minimum":1,"maximum":1048576}},"additionalProperties":false},
    "expected_work":{"type":"object","required":["checksum"],"properties":{"checksum":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"additionalProperties":false}
  },
  "additionalProperties":false
}
