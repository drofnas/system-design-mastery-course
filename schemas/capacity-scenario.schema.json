{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/capacity-scenario.schema.json",
  "title": "Capacity lab scenario",
  "type": "object",
  "required": ["id", "seed", "arrival", "service", "retry", "capacity"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "arrival": {
      "type": "object",
      "required": ["mode", "rate_per_second", "duration_seconds"],
      "properties": {
        "mode": {"enum": ["open", "closed"]},
        "rate_per_second": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        },
        "max_in_flight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "burst_multiplier": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "burst_start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "burst_duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "workers",
        "queue_capacity",
        "base_service_ms",
        "slow_service_ms",
        "slow_probability",
        "fanout",
        "downstream_concurrency",
        "downstream_failure_probability"
      ],
      "properties": {
        "workers": {"type": "integer", "minimum": 1, "maximum": 1000},
        "queue_capacity": {"type": "integer", "minimum": 1, "maximum": 100000},
        "base_service_ms": {"type": "number", "minimum": 0.1, "maximum": 60000},
        "slow_service_ms": {"type": "number", "minimum": 0.1, "maximum": 60000},
        "slow_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "fanout": {"type": "integer", "minimum": 1, "maximum": 100},
        "downstream_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "downstream_failure_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "required": ["max_attempts", "budget_ratio", "base_backoff_ms"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "budget_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "base_backoff_ms": {"type": "number", "minimum": 0, "maximum": 60000}
      },
      "additionalProperties": false
    },
    "capacity": {
      "type": "object",
      "required": [
        "failover_fraction",
        "worker_cost_per_hour",
        "fixed_cost_per_hour"
      ],
      "properties": {
        "failover_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "worker_cost_per_hour": {"type": "number", "minimum": 0},
        "fixed_cost_per_hour": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
