{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/solo-gate-challenge.schema.json",
  "title": "Sealed local gate challenge",
  "type": "object",
  "required": ["schema_version", "gate", "challenge_id", "variant_id", "seed", "title", "module_ids", "synthetic", "assurance_limitation", "workload", "observations", "target_invariants", "diagnosis_instructions", "envelope_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "gate": {"enum": ["G01", "G02", "G03", "G04", "G05", "G06"]},
    "challenge_id": {"type": "string", "pattern": "^G0[1-6]-[a-f0-9]{16}$"},
    "variant_id": {"type": "string", "pattern": "^G0[1-6]-V0[1-3]$"},
    "seed": {"type": "integer", "minimum": 0},
    "title": {"type": "string", "minLength": 10},
    "module_ids": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^M(0[1-9]|1[0-8])$"}},
    "synthetic": {"const": true},
    "assurance_limitation": {"type": "string", "minLength": 80},
    "workload": {
      "type": "object",
      "required": ["description", "sha256"],
      "properties": {
        "description": {"type": "string", "minLength": 30},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["metric", "value", "unit"],
        "properties": {
          "metric": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "target_invariants": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
    "diagnosis_instructions": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 10}},
    "envelope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
