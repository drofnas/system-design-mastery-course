{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/solo-gate-repair.schema.json",
  "title": "Learner gate repair evidence",
  "type": "object",
  "required": ["schema_version", "gate", "challenge_id", "challenge_sha256", "workload_sha256", "measurements", "evidence_paths"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "gate": {"enum": ["G01", "G02", "G03", "G04", "G05", "G06"]},
    "challenge_id": {"type": "string", "pattern": "^G0[1-6]-[a-f0-9]{16}$"},
    "challenge_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "measurements": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "number"}},
    "evidence_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
