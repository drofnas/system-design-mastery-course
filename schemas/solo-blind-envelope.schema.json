{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/solo-blind-envelope.schema.json",
  "title": "Solo blind reveal envelope payload",
  "type": "object",
  "required": ["schema_version", "module", "collection_id", "manifest_core_sha256", "bundles", "mapping", "assurance_limitation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "module": {"enum": ["M04", "M05"]},
    "collection_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "manifest_core_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bundles": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "mapping": {"type": "object", "minProperties": 2},
    "assurance_limitation": {"type": "string", "minLength": 40}
  },
  "additionalProperties": false
}
