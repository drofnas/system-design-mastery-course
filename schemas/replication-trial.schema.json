{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/replication-trial.schema.json",
  "title": "Replication and partitioning lab trial",
  "type": "object",
  "required": ["schema_version", "scenario_id", "pair_id", "variant", "seed", "evidence_kind", "environment", "shared_input_sha256", "config_sha256", "trace", "acknowledgements", "observed_versions", "availability", "consistency", "conflicts", "repair", "placement", "load", "invariants", "uncertainty"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scenario_id": {"type": "string"},
    "pair_id": {"type": "string", "pattern": "^F0[1-6]$"},
    "variant": {"enum": ["broken", "repaired"]},
    "seed": {"type": "integer"},
    "evidence_kind": {"const": "deterministic-local-model"},
    "environment": {"type": "object"},
    "shared_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trace": {"type": "array", "minItems": 1},
    "acknowledgements": {"type": "object", "required": ["attempted", "successful", "ambiguous"]},
    "observed_versions": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "availability": {"type": "object", "required": ["accepted", "total", "ratio"]},
    "consistency": {"type": "object", "required": ["staleness_versions", "read_your_writes_violations", "monotonic_read_violations", "concurrent_conflicts_preserved"]},
    "conflicts": {"type": "object", "required": ["detected", "preserved", "resolved"]},
    "repair": {"type": "object", "required": ["attempted", "converged", "rounds", "bytes"]},
    "placement": {"type": "object", "required": ["strategy", "key_count", "moved_keys", "movement_ratio", "missing_keys", "duplicate_authorities"]},
    "load": {"type": "object", "required": ["per_node", "per_tenant", "imbalance_ratio", "rejected"]},
    "invariants": {"type": "array", "minItems": 1},
    "uncertainty": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false
}
