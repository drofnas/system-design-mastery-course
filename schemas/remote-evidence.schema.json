{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/remote-evidence.schema.json",
  "title": "PESD-104 remote fallback evidence envelope",
  "type": "object",
  "required": [
    "schema_version", "module", "source_commit", "evidence_mode", "runner",
    "container_images", "resource_limits", "clock", "input_hashes",
    "raw_outcomes", "limitations", "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "module": {"enum": ["M10", "M15", "M16", "M17"]},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "evidence_mode": {"enum": ["executed_deterministic", "measured_container"]},
    "runner": {
      "type": "object",
      "required": ["kind", "version", "os", "architecture"],
      "properties": {
        "kind": {"const": "github_actions"},
        "version": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "container_images": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["reference", "digest"],
        "properties": {
          "reference": {"type": "string", "minLength": 3},
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "resource_limits": {
      "type": "object", "required": ["cpus", "memory", "pids"],
      "properties": {
        "cpus": {"type": "number", "minimum": 1, "maximum": 4},
        "memory": {"type": "string", "pattern": "^[1-8]g$"},
        "pids": {"type": "integer", "minimum": 32, "maximum": 512}
      },
      "additionalProperties": false
    },
    "clock": {
      "type": "object", "required": ["wall", "monotonic"],
      "properties": {
        "wall": {"const": "UTC"},
        "monotonic": {"type": "string", "minLength": 3}
      },
      "additionalProperties": false
    },
    "input_hashes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "raw_outcomes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
