{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/system-design-course/runtime-fanout-request.schema.json",
  "title":"Module 15 bounded fan-out request",
  "type":"object",
  "required":["request_id","deadline_ms","concurrency_limit","children"],
  "properties":{
    "request_id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"},
    "deadline_ms":{"type":"integer","minimum":50,"maximum":5000},
    "concurrency_limit":{"type":"integer","minimum":1,"maximum":64},
    "children":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","required":["child_id","required","delay_ms","payload_bytes"],"properties":{"child_id":{"type":"string","pattern":"^[a-z0-9-]{1,32}$"},"required":{"type":"boolean"},"delay_ms":{"type":"integer","minimum":0,"maximum":10000},"payload_bytes":{"type":"integer","minimum":0,"maximum":2097152},"mode":{"enum":["ok","error","invalid"]}},"additionalProperties":false}}
  },
  "additionalProperties":false
}
