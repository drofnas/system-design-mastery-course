{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/system-design-course/messaging-scenario.schema.json",
  "title":"Module 11 deterministic messaging scenario",
  "type":"object",
  "required":["schema_version","scenario_id","pair_id","variant","seed","workload","initial_state","events","controls","expected"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "scenario_id":{"type":"string","pattern":"^f0[1-9]-[a-z0-9-]+-(broken|repaired)$"},
    "pair_id":{"type":"string","pattern":"^F0[1-9]$"},
    "variant":{"enum":["broken","repaired"]},
    "seed":{"type":"integer","minimum":0},
    "workload":{"type":"object","required":["aggregate_id","event_id","aggregate_version","arrival_rate","service_rate","backlog","event_time","processing_time"],"additionalProperties":false},
    "initial_state":{"type":"object","required":["authority_version","projection_version","workflow_state"],"additionalProperties":false},
    "events":{"type":"array","minItems":1,"items":{"type":"object","required":["tick","type"],"additionalProperties":true}},
    "controls":{"type":"object","required":["atomic_outbox","inbox_deduplication","effect_idempotency","enforce_versions","quarantine_poison","bounded_recovery","durable_workflow","late_data_policy","reconcile_derived"],"properties":{"atomic_outbox":{"type":"boolean"},"inbox_deduplication":{"type":"boolean"},"effect_idempotency":{"type":"boolean"},"enforce_versions":{"type":"boolean"},"quarantine_poison":{"type":"boolean"},"bounded_recovery":{"type":"boolean"},"durable_workflow":{"type":"boolean"},"late_data_policy":{"enum":["drop","correct"]},"reconcile_derived":{"type":"boolean"}},"additionalProperties":false},
    "expected":{"type":"object","required":["target_invariant","repaired_invariants"],"properties":{"target_invariant":{"type":"string","pattern":"^I(0[1-9]|1[0-2])$"},"repaired_invariants":{"type":"array","minItems":12,"maxItems":12,"uniqueItems":true,"items":{"type":"string","pattern":"^I(0[1-9]|1[0-2])$"}}},"additionalProperties":false}
  },
  "additionalProperties":false
}
