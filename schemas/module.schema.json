{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/solo-course/module.schema.json",
  "title": "Solo course module manifest",
  "type": "object",
  "required": [
    "course_id",
    "course_version",
    "id",
    "title",
    "status",
    "focus",
    "pacing",
    "lessons",
    "learning_outcomes",
    "practice",
    "lab",
    "quiz",
    "optional_project",
    "resources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "course_id": {
      "const": "CSSDM"
    },
    "course_version": {
      "const": "3.1-solo"
    },
    "id": {
      "type": "string",
      "pattern": "^M[0-9]{2}$"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "retired"
      ]
    },
    "focus": {
      "type": "string"
    },
    "pacing": {
      "type": "object"
    },
    "lessons": {
      "type": "array",
      "minItems": 6,
      "maxItems": 8
    },
    "learning_outcomes": {
      "type": "array",
      "minItems": 4
    },
    "practice": {
      "type": "object",
      "required": [
        "exercises_path",
        "answer_key_path"
      ]
    },
    "lab": {
      "type": "object",
      "required": [
        "required",
        "path",
        "note"
      ]
    },
    "quiz": {
      "type": "object",
      "required": [
        "question_bank_path",
        "answer_key_path",
        "llm_grader_prompt_path",
        "question_count",
        "default_draw_count",
        "types"
      ]
    },
    "optional_project": {
      "type": "object",
      "required": [
        "description"
      ]
    },
    "resources": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
