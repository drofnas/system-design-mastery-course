{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/module.schema.json",
  "title": "Course module manifest",
  "type": "object",
  "required": [
    "id",
    "title",
    "weeks",
    "lesson_catalog",
    "target_hours",
    "status",
    "outcomes",
    "resources",
    "artifacts",
    "failure_experiments",
    "factual_claims_path",
    "solo_review",
    "assessment"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^M[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "weeks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["number", "focus", "hours", "evidence", "time_blocks"],
        "properties": {
          "number": {"type": "integer", "minimum": 1, "maximum": 72},
          "focus": {"type": "string"},
          "hours": {"type": "number", "minimum": 10, "maximum": 12},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "time_blocks": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "required": ["id", "label", "minutes", "activity"],
              "properties": {
                "id": {"type": "string", "pattern": "^W[0-9]{2}-T[0-9]{2}$"},
                "label": {"type": "string", "minLength": 3},
                "minutes": {"type": "integer", "minimum": 15},
                "activity": {"enum": ["local_instruction", "required_resource", "guided_practice", "independent_work", "failure_experiment", "decision_artifact", "assessment", "teach_back", "review_remediation", "reflection"]},
                "lesson_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^L[0-9]{2}$"}},
                "resource_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RES-[0-9]{2}$"}},
                "exercise_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^EX-[0-9]{2}$"}},
                "artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^A[0-9]{2}$"}}
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "lesson_catalog": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "path", "estimated_minutes"],
        "properties": {
          "id": {"type": "string", "pattern": "^L[0-9]{2}$"},
          "path": {"type": "string", "pattern": "^lessons/.+\\.md$"},
          "estimated_minutes": {"type": "integer", "minimum": 15, "maximum": 180}
        },
        "additionalProperties": false
      }
    },
    "target_hours": {
      "type": "number",
      "minimum": 40,
      "maximum": 48
    },
    "status": {
      "enum": ["draft", "review", "ready", "retired"]
    },
    "outcomes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "graduate_profile",
          "mastery_levels",
          "lessons",
          "exercises",
          "artifacts",
          "rubric"
        ]
      }
    },
    "resources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "url",
          "required",
          "access",
          "week",
          "estimated_minutes",
          "assignment",
          "last_verified",
          "text_alternative"
          ,"verified_title",
          "verified_publisher",
          "verification_method",
          "final_url",
          "verification_status"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "week", "required", "template_path", "submission_path", "portfolio_category"],
        "properties": {
          "portfolio_category": {"enum": ["adr", "rfc", "controlled_incident_postmortem", "capacity_cost_model", "performance_investigation", "failure_matrix", "threat_model", "dr_exercise", "migration_plan", "runtime_comparison", "teach_back", "capstone", "implementation", "model", "learning_log", "evaluation"]}
        }
      }
    },
    "failure_experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scenario", "evidence"]
      }
    },
    "factual_claims_path": {
      "type": "string",
      "pattern": "^modules/[0-9]{2}-.+/assessment/factual-claims\\.json$"
    },
    "solo_review": {
      "type": "object",
      "required": ["challenge_questions", "required_reviewer_roles", "questions_per_attempt", "live_ai_allowed", "record_template_path"],
      "properties": {
        "challenge_questions": {
          "type": "array", "minItems": 8, "uniqueItems": true,
          "items": {
            "type": "object", "required": ["id", "prompt"],
            "properties": {"id": {"type": "string"}, "prompt": {"type": "string", "minLength": 20}},
            "additionalProperties": false
          }
        },
        "required_reviewer_roles": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "questions_per_attempt": {"const": 5},
        "live_ai_allowed": {"const": false},
        "record_template_path": {"const": "templates/solo-review-record-template.md"}
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": [
        "rubric_path",
        "evaluator_prompt_path",
        "evaluation_schema_path",
        "calibration_path",
        "pass_average",
        "safety_critical_criteria"
      ]
    }
  },
  "additionalProperties": true
}
