{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/evolution-trial.schema.json",
  "title": "Module 14 deterministic architecture evolution trial",
  "type": "object",
  "required": ["schema_version","scenario_id","pair_id","variant","seed","scenario_sha256","shared_input_sha256","config_sha256","boundary_decision","compatibility","schema_evolution","backfill","write_authority","shadow_validation","cutover_rollback","economics","dependency_strategy","ownership","invariants","evidence_boundaries"],
  "properties": {
    "schema_version":{"const":"1.0"},
