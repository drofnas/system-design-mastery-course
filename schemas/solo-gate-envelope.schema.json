{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/solo-gate-envelope.schema.json",
  "title": "Local gate reveal envelope",
  "type": "object",
  "required": ["schema_version", "gate", "challenge_id", "challenge_core_sha256", "encoding", "payload", "payload_sha256", "assurance_limitation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "gate": {"enum": ["G01", "G02", "G03", "G04", "G05", "G06"]},
    "challenge_id": {"type": "string", "pattern": "^G0[1-6]-[a-f0-9]{16}$"},
    "challenge_core_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "encoding": {"const": "base64+zlib"},
    "payload": {"type": "string", "minLength": 20},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assurance_limitation": {"type": "string", "minLength": 80}
  },
  "additionalProperties": false
}
