{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/evaluation-bundle.schema.json",
  "title": "Immutable evaluation bundle manifest",
  "type": "object",
  "required": [
    "schema_version",
    "module",
    "artifact_commit",
    "bundle_sha256",
    "structural_validation_passed",
    "files",
    "evaluator_instruction",
    "completion_instruction"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "module": {"type": "string", "pattern": "^M(0[1-9]|1[0-8])$"},
    "artifact_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "structural_validation_passed": {"type": "boolean"},
    "files": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "role", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "evaluator_instruction": {"type": "string", "minLength": 40},
    "completion_instruction": {"type": "string", "minLength": 40}
  },
  "additionalProperties": false
}
