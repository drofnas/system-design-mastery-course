{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/gate.schema.json",
  "title": "PESD-104 standalone gate",
  "type": "object",
  "required": [
    "id", "week", "modules", "core_minutes", "parts", "domain_matrix",
    "rubric_rows", "hard_floors", "invariant_sets", "result_rules",
    "remediation_reserve_hours"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^G0[1-6]$"},
    "week": {"type": "integer", "minimum": 1, "maximum": 104},
    "modules": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^M(0[1-9]|1[0-8])$"}
    },
    "core_minutes": {"enum": [390, 570]},
    "parts": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "title", "minutes", "minimum_score", "new_teaching", "new_build_work"],
        "properties": {
          "id": {"enum": ["freeze", "written", "practical", "defense", "portfolio", "closure"]},
          "title": {"type": "string", "minLength": 3},
          "minutes": {"type": "integer", "minimum": 30, "maximum": 180},
          "minimum_score": {"type": "number", "minimum": 0, "maximum": 4},
          "new_teaching": {"const": false},
          "new_build_work": {"const": false}
        },
        "additionalProperties": false
      }
    },
    "domain_matrix": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "required": ["module", "criteria", "minimum_score"],
        "properties": {
          "module": {"type": "string", "pattern": "^M(0[1-9]|1[0-8])$"},
          "criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "minimum_score": {"type": "number", "minimum": 3, "maximum": 3.5}
        },
        "additionalProperties": false
      }
    },
    "rubric_rows": {
      "type": "array", "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "title", "safety_critical"],
        "properties": {
          "id": {"type": "string", "pattern": "^GR[0-9]{2}$"},
          "title": {"type": "string", "minLength": 3},
          "safety_critical": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "hard_floors": {
      "type": "object",
      "required": ["part", "domain", "safety", "overall"],
      "properties": {
        "part": {"const": 3},
        "domain": {"const": 3},
        "safety": {"const": 3},
        "overall": {"enum": [3, 3.5]},
        "longitudinal_capstone": {"const": 3.5},
        "review_dimensions": {
          "type": "object",
          "required": ["product", "technical", "security_governance", "operations_recovery", "economics", "ownership_migration"],
          "properties": {
            "product": {"const": 3},
            "technical": {"const": 3},
            "security_governance": {"const": 3},
            "operations_recovery": {"const": 3},
            "economics": {"const": 3},
            "ownership_migration": {"const": 3}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "invariant_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "invariants", "required_to_pass"],
        "properties": {
          "id": {"enum": ["commerce", "retrieval_agent"]},
          "invariants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "required_to_pass": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "result_rules": {
      "type": "object",
      "required": ["Pass", "Revise", "Repeat"],
      "properties": {
        "Pass": {"type": "string", "minLength": 20},
        "Revise": {"type": "string", "minLength": 20},
        "Repeat": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "remediation_reserve_hours": {"const": 6}
  },
  "additionalProperties": false
}
