{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/evaluation.schema.json",
  "title": "Module evaluation result",
  "type": "object",
  "required": [
    "module_id",
    "artifact_commit",
    "baseline_tag",
    "evaluated_at",
    "structural_gates",
    "rubric_scores",
    "average_score",
    "safety_critical_zero",
    "result",
    "confidence",
    "summary",
    "next_actions"
  ],
  "properties": {
    "module_id": {"type": "string", "pattern": "^M[0-9]{2}$"},
    "artifact_commit": {"type": "string", "minLength": 7},
    "baseline_tag": {"type": ["string", "null"]},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "structural_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "passed", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "passed": {"type": "boolean"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "rubric_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "score",
          "evidence",
          "findings",
          "remediation"
        ],
        "properties": {
          "criterion_id": {"type": "string"},
          "score": {"type": "integer", "minimum": 0, "maximum": 4},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "findings": {"type": "array", "items": {"type": "string"}},
          "remediation": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "average_score": {"type": "number", "minimum": 0, "maximum": 4},
    "safety_critical_zero": {"type": "boolean"},
    "result": {"enum": ["Pass", "Revise", "Repeat"]},
    "confidence": {
      "type": "object",
      "required": ["level", "reasons"],
      "properties": {
        "level": {"enum": ["high", "medium", "low"]},
        "reasons": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "summary": {"type": "string"},
    "next_actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
