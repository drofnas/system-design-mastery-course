{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system-design-course/consensus-trial.schema.json",
  "title": "Module 10 deterministic consensus trial",
  "type": "object",
  "required": ["schema_version","scenario_id","pair_id","variant","seed","scenario_sha256","shared_input_sha256","config_sha256","topology","events","nodes","client_results","deduplication_records","key_values","resource","membership","metrics","invariants","evidence_boundary"],
  "properties": {
    "schema_version":{"const":"1.0"},
    "scenario_id":{"type":"string"},
    "pair_id":{"type":"string","pattern":"^F0[1-8]$"},
    "variant":{"enum":["broken","repaired"]},
    "seed":{"type":"integer"},
    "scenario_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "shared_input_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "config_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "topology":{"type":"object","required":["nodes","voters"],"additionalProperties":true},
    "events":{"type":"array","minItems":1,"items":{"type":"object","required":["tick","type","detail"],"additionalProperties":true}},
    "nodes":{"type":"array","minItems":3,"items":{"type":"object","required":["id","role","current_term","voted_for","log","commit_index","last_applied","snapshot","membership"],"additionalProperties":false}},
    "client_results":{"type":"array","items":{"type":"object","required":["client_id","sequence","status","logical_effects"],"additionalProperties":true}},
    "deduplication_records":{"type":"object"},
    "key_values":{"type":"object"},
    "resource":{"type":"object","required":["max_fence","accepted","rejected"],"additionalProperties":true},
    "membership":{"type":"object","required":["old","joint","new","phase","quorum_proofs"],"additionalProperties":true},
    "metrics":{"type":"object","required":["messages","elections","commits","applies","unavailable_operations"],"additionalProperties":{"type":"integer","minimum":0}},
    "invariants":{"type":"array","minItems":10,"maxItems":10,"items":{"type":"object","required":["id","name","passed","evidence"],"additionalProperties":false}},
    "evidence_boundary":{"type":"array","minItems":1,"items":{"type":"string"}}
  },
  "additionalProperties":false
}
