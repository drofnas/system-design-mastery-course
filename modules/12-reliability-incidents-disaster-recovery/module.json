      "evidence": "journey events, queue/concurrency bounds, dependency latency, priority admissions, degraded output, mitigation timing, and bounded-work invariant"
    },
    {
      "id": "F02",
      "scenario": "fast and sustained error-budget burn",
      "evidence": "valid/bad counts, SLO error fraction, window rates, burn arithmetic, page/ticket decision, reset behavior, and alert-action invariant"
    },
    {
      "id": "F03",
      "scenario": "healthy components hiding failed user journeys",
      "evidence": "component probes, journey start/end, correctness/freshness/latency results, exclusions, missing telemetry, and journey-measurement invariant"
    },
    {
      "id": "F04",
      "scenario": "conflicting mitigations and incomplete incident handoff",
      "evidence": "roles, timeline, declared priorities, change serialization, handoff state, communications cadence, and coordination invariant"
    },
    {
      "id": "F05",
      "scenario": "corrupt or incomplete backup selected for restore",
