  "failure_experiments": [
    {
      "id": "F01",
      "scenario": "crash between authority commit and publish",
      "evidence": "authority transaction, outbox row, event identity, publish state, pending visibility, and atomic-publication invariant"
    },
    {
      "id": "F02",
      "scenario": "lost broker acknowledgement and republish",
      "evidence": "stable event identity, append attempts, offsets, inbox state, logical applications, and duplicate-delivery invariant"
    },
    {
      "id": "F03",
      "scenario": "crash after external effect before consumer acknowledgement",
      "evidence": "effect key, effect ledger, inbox transaction, offset, responses, and irreversible-effect count"
    },
    {
      "id": "F04",
      "scenario": "reordered updates for one aggregate",
      "evidence": "aggregate identity/version, partition, arrival/application order, projection version, and monotonicity invariant"
    },
    {
