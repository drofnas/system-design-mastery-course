{
  "name": "northstar-browser-edge-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24.19.0 <25"},
  "scripts": {
    "build": "esbuild src/client.jsx --bundle --minify --sourcemap --outfile=dist/client.js",
    "start": "node src/server.js",
    "test:unit": "node --test tests/server.test.js",
    "test:browser": "playwright test",
    "test": "npm run build && npm run test:unit && npm run test:browser"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.1"
  }
}
