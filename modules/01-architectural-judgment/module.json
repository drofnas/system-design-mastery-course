  "failure_experiments": [
    {
      "id": "F01",
      "scenario": "Tenfold traffic burst",
      "evidence": "Predicted behavior, saturated responsibility, affected journey, invariant exposure, and follow-up measurement"
    },
    {
      "id": "F02",
      "scenario": "One slow dependency",
      "evidence": "Critical-path effect, queue or concurrency propagation, bounded response, and unsupported assumptions"
    },
    {
      "id": "F03",
      "scenario": "Stale data",
      "evidence": "Operation-specific consequence, invariant impact, user-visible behavior, and detection"
    },
    {
      "id": "F04",
      "scenario": "Operator mistake",
      "evidence": "Blast radius, prevention, detection, recovery, ownership, and residual risk"
    },
    {
      "id": "F05",
      "scenario": "Loss of one hosting zone",
      "evidence": "Capacity and state assumptions, degraded behavior, recovery path, and excluded correlated faults"
    }
